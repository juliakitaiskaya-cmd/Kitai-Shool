{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "banners/**",
              "ui_kits/platform/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Inter|Noto Serif SC|Noto Sans SC))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Inter, Noto Serif SC, Noto Sans SC."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--brick",
      "--brick-deep",
      "--brick-soft",
      "--cream",
      "--cream-2",
      "--font-display",
      "--font-han",
      "--font-han-ui",
      "--font-sans",
      "--fs-body",
      "--fs-display",
      "--fs-h1",
      "--fs-h2",
      "--fs-h3",
      "--fs-lg",
      "--fs-sm",
      "--fs-xs",
      "--hairline",
      "--hairline-2",
      "--highlight",
      "--info",
      "--ink",
      "--ink-2",
      "--lh-body",
      "--lh-display",
      "--lh-h1",
      "--lh-h2",
      "--lh-h3",
      "--lh-lg",
      "--lh-sm",
      "--lh-xs",
      "--r-btn",
      "--r-lg",
      "--r-md",
      "--r-pill",
      "--r-sm",
      "--r-xs",
      "--shadow-card",
      "--shadow-lift",
      "--shadow-sm",
      "--sp-1",
      "--sp-2",
      "--sp-3",
      "--sp-4",
      "--sp-5",
      "--sp-6",
      "--sp-7",
      "--sp-8",
      "--sp-9",
      "--success",
      "--success-soft",
      "--surface",
      "--taupe",
      "--taupe-soft",
      "--warn"
    ],
    "tokenKinds": {
      "--brick": "color",
      "--brick-deep": "color",
      "--brick-soft": "color",
      "--ink": "color",
      "--ink-2": "color",
      "--taupe": "color",
      "--taupe-soft": "color",
      "--cream": "color",
      "--cream-2": "color",
      "--surface": "color",
      "--highlight": "color",
      "--success": "color",
      "--success-soft": "color",
      "--warn": "color",
      "--info": "color",
      "--hairline": "color",
      "--hairline-2": "color",
      "--shadow-sm": "shadow",
      "--shadow-card": "shadow",
      "--shadow-lift": "shadow",
      "--r-xs": "spacing",
      "--r-sm": "spacing",
      "--r-md": "spacing",
      "--r-lg": "spacing",
      "--r-btn": "spacing",
      "--r-pill": "spacing",
